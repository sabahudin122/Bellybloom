generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  image        String?
  role         String   @default("USER")
  status       String   @default("ACTIVE")
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  babies       Baby[]
  favorites    Favorite[]
  generatedRecipes Recipe[] @relation("GeneratedRecipes")
  posts        Post[]
  comments     Comment[]
  postLikes    PostLike[]
  reportsFiled Report[] @relation("ReportReporter")
  reportsReviewed Report[] @relation("ReportReviewer")
  moderationActions ModerationAction[] @relation("ModerationAdmin")

  @@index([lastActiveAt])
  @@index([createdAt])
}

model Baby {
  id                    String        @id @default(cuid())
  userId                String
  name                  String
  dateOfBirth           DateTime
  allergyStatus         String        @default("NOT_SURE")
  otherAllergies        String?
  feedingStageOverride  String?
  foodsIntroduced       String        @default("[]")
  foodsDisliked         String        @default("[]")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergies             BabyAllergy[]
  mealPlans             MealPlan[]
  foodLogs              FoodLog[]
  generatedRecipes      Recipe[]      @relation("BabyGeneratedRecipes")
  recipeRejections      RecipeRejection[]

  @@index([userId])
  @@index([createdAt])
}

model BabyAllergy {
  id        String   @id @default(cuid())
  babyId    String
  allergen  String
  createdAt DateTime @default(now())
  baby      Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@unique([babyId, allergen])
  @@index([babyId])
}

model SafetySource {
  id            String       @id @default(cuid())
  title         String
  organization  String
  sourceUrl     String
  version       String
  reviewDate    DateTime
  reviewerName  String
  reviewerNotes String
  status        String       @default("ACTIVE")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rules         SafetyRule[]
  ageStages     AgeStage[]
  recipes       Recipe[]

  @@unique([organization, version])
}

model SafetyRule {
  id                   String       @id @default(cuid())
  sourceId             String
  code                 String       @unique
  title                String
  description          String
  kind                 String
  termsJson            String
  minAgeMonthsInclusive Int?
  maxAgeMonthsExclusive Int?
  requiredPreparation  String?
  severity             String       @default("BLOCK")
  rulesetVersion       String
  reviewDate           DateTime
  reviewerNotes        String
  active               Boolean      @default(true)
  source               SafetySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([active, kind])
}

model AgeStage {
  id                    String       @id @default(cuid())
  sourceId              String
  slug                  String       @unique
  title                 String
  minAgeMonthsInclusive Int
  maxAgeMonthsExclusive Int?
  summary               String
  foods                 String
  avoid                 String
  textures              String
  mealsPerDay           String
  warnings              String
  sortOrder              Int
  active                 Boolean      @default(true)
  source                 SafetySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sortOrder])
}

model Recipe {
  id                  String       @id @default(cuid())
  sourceId            String
  createdByUserId     String?
  generatedForBabyId  String?
  title               String
  slug                String       @unique
  description         String
  mealType            String
  ingredientsJson     String
  instructionsJson    String
  prepMinutes         Int
  texture             String
  minAgeMonths        Int
  maxAgeMonthsExclusive Int?
  allergenTagsJson    String       @default("[]")
  whyGood             String
  reviewStatus        String       @default("ADMIN_REVIEWED")
  rulesetVersion      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  source              SafetySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdBy           User?        @relation("GeneratedRecipes", fields: [createdByUserId], references: [id], onDelete: Cascade)
  generatedForBaby    Baby?        @relation("BabyGeneratedRecipes", fields: [generatedForBabyId], references: [id], onDelete: SetNull)
  favorites           Favorite[]

  @@index([title])
  @@index([createdAt])
  @@index([createdByUserId])
  @@index([generatedForBabyId])
  @@index([minAgeMonths, mealType])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId, createdAt])
  @@index([recipeId])
}

model FoodLog {
  id        String   @id @default(cuid())
  babyId    String
  foodName  String
  reaction  String   @default("NONE")
  notes     String?
  servedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  baby      Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@index([babyId, servedAt])
  @@index([createdAt])
}

model MealPlan {
  id             String   @id @default(cuid())
  babyId         String
  planDate       DateTime
  mealsJson      String
  servedSlotsJson String  @default("[]")
  source         String
  rulesetVersion String
  generationCount Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  baby           Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@unique([babyId, planDate])
  @@index([babyId])
  @@index([createdAt])
}

model RecipeRejection {
  id             String   @id @default(cuid())
  babyId         String
  userId         String
  requestType    String
  promptSummary  String
  candidateJson  String
  reasonsJson    String
  rulesetVersion String
  createdAt      DateTime @default(now())
  baby           Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@index([babyId, createdAt])
  @@index([userId, createdAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
}

model Post {
  id          String    @id @default(cuid())
  authorId    String
  title       String
  body        String
  category    String
  ageStageTag String?
  status      String    @default("PUBLISHED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       PostLike[]
  reports     Report[]

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id           String    @id @default(cuid())
  postId       String
  authorId     String
  parentId     String?
  body         String
  status       String    @default("PUBLISHED")
  isBestAnswer Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("CommentReplies")
  reports      Report[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  postId       String?
  commentId    String?
  reason       String
  details      String?
  status       String    @default("OPEN")
  reviewerId   String?
  resolution   String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reporter     User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer     User?     @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  post         Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([postId])
  @@index([commentId])
}

model ModerationAction {
  id         String   @id @default(cuid())
  adminId    String?
  targetType String
  targetId   String
  action     String
  notes      String?
  createdAt  DateTime @default(now())
  admin      User?    @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}
